# Локальный dev/деплой-конфиг для Makefile (rsync/ssh-деплой на прод/dev-ноду,
# ADB для тестов на Android, --require-auth для debug-server). Скопировать в
# .env и заполнить реальными значениями — .env уже в .gitignore, коммитить
# нельзя.

# --- Прод-нода (make deploy / make restart и т.п.) ---
SERVER_IP=CHANGE_ME_PROD_NODE_IP
REMOTE_USER=root
REMOTE_PATH=/root/netr-core
SERVICE_NAME=netrunner-server
MASQUE_SERVICE_NAME=netrunner-masque-edge

# --- Dev-нода (make deploy-dev и т.п.) ---
DEV_IP=CHANGE_ME_DEV_NODE_IP

# --- Android (ADB по Wi-Fi + сборка нативной либы для vpn-plugin) ---
ANDROID_ADB_HOST=CHANGE_ME_PHONE_LOCAL_IP
ANDROID_BUILD_SRC=/home/CHANGE_ME/netrunner/netrunner-proxy/gen
ANDROID_PROJECT_LIBS=/home/CHANGE_ME/netrunner/netrunner-app/src-tauri/src/plugins/vpn-plugin/android/src/main/jniLibs

# --- Дев-авторизация debug-server (make debug-server и т.п.) ---
# Секрет теперь свой у каждой ноды (хранится в БД бэкенда, vpn_nodes.internal_secret,
# см. netrunner-backend/src/modules/proxy_internal) — не общая env-переменная на
# всю систему. Для локального дев-стенда: возьми любой уже существующий секрет
# ноды из dev-БД, либо создай тестовую ноду через админку и скопируй её секрет
# оттуда (POST /admin/nodes/{id}/secret вернёт его один раз в ответе).
PROXY_INTERNAL_SECRET=CHANGE_ME_COPY_FROM_A_DEV_NODE_IN_ADMIN_PANEL
DEV_BACKEND_URL=http://localhost:8080

# --- Учётные данные ноды для аутентифицированного хендшейка (NRXP v3) ---
# Заводятся в админке вместе с нодой (vpn_nodes.nrxp_secret /
# nrxp_static_private / nrxp_static_public), сюда попадают провижинингом.
# Оба значения — 32 байта в hex (64 символа), задаются ТОЛЬКО вместе.
#
# Что они закрывают:
#   PROXY_NRXP_SECRET      — тег ClientHello перестаёт быть чистой функцией
#                            времени; барьер на входе 0 бит → 256. Этот секрет
#                            бэкенд раздаёт и клиентам — он против сканеров,
#                            а не против MITM.
#   PROXY_NRXP_PRIVATE_KEY — приватная половина статического ключа ноды.
#                            НЕ покидает ноду. Именно она даёт аутентификацию
#                            сервера и защиту от активного посредника: без неё
#                            второй DH хендшейка не посчитать.
#
# Это НЕ PROXY_INTERNAL_SECRET и не замена ему: тот пускает ноду в
# control-plane бэкенда и клиентам не отдаётся никогда.
PROXY_NRXP_SECRET=CHANGE_ME_64_HEX_CHARS_FROM_ADMIN_PANEL
PROXY_NRXP_PRIVATE_KEY=CHANGE_ME_64_HEX_CHARS_FROM_ADMIN_PANEL
# Отвергать клиентов, пришедших по старой анонимной схеме (v2). На время
# раскатки — false, иначе не обновлённые приложения отвалятся. Включить
# обязательно, когда бэкенд раздал ключи всем: пока обе схемы живы, посреднику
# достаточно переписать заявленную версию в ClientHello, чтобы увести
# соединение на неаутентифицированную.
PROXY_NRXP_STRICT=false
