namespace netrunner_client {};

dictionary VpnTrafficStats {
    u64 rx_bytes;
    u64 tx_bytes;
    u64 rx_packets;
    u64 tx_packets;
};

interface SessionManager {
    constructor();
    // Добавлены параметры для Killswitch и исключений, и sni (декой ClientHello)
    Session spawn_session(
        string remote_address,
        string sni,
        i32? tun_fd,
        string cache_path,
        boolean killswitch_enabled,
        sequence<string> excluded_apps,
        sequence<string> excluded_domains,
        string? auth_token
    );
    VpnTrafficStats get_traffic_stats();
};

interface Session {
    void stop();
};
