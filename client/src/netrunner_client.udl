namespace netrunner_client {};

dictionary VpnTrafficStats {
    u64 rx_bytes;
    u64 tx_bytes;
    u64 rx_packets;
    u64 tx_packets;
};

interface SessionManager {
    constructor();
    // Добавлены параметры для Killswitch и исключений, и sni (декой ClientHello)
    Session spawn_session(
        string remote_address,
        string sni,
        i32? tun_fd,
        string cache_path,
        boolean killswitch_enabled,
        sequence<string> excluded_apps,
        sequence<string> excluded_domains,
        string? auth_token,
        // Учётные данные ноды из списка серверов бэкенда (hex по 64 символа):
        // включают аутентифицированный хендшейк. Оба null — старая анонимная
        // схема, сервер клиенту ничем себя не подтверждает.
        string? node_secret,
        string? node_public_key,
        // Корпоративный (managed) режим: "all" | "resources" | "bypass_lan".
        // Строка, а не enum, сознательно — значение приезжает с бэкенда как
        // строка политики и здесь только пробрасывается; лишний тип в UDL
        // означал бы конвертацию в каждом из трёх мостов (Kotlin/Swift/Rust)
        // без единой выгоды. Неизвестное значение трактуется как "all".
        string? tunnel_mode,
        // Подсети ресурсов организации (CIDR). Нужны только в режиме
        // "resources"; в остальных игнорируются.
        sequence<string> routed_cidrs
    );
    VpnTrafficStats get_traffic_stats();
};

interface Session {
    void stop();
};
