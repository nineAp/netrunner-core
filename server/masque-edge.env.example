# Скопировать на ноду в /etc/netrunner/masque-edge.env с правами 0600.
# Сертификат должен быть публично доверенным и содержать relay hostname в SAN.

MASQUE_BIND=0.0.0.0:443
MASQUE_CERT_FILE=/etc/letsencrypt/live/relay.example.com/fullchain.pem
MASQUE_KEY_FILE=/etc/letsencrypt/live/relay.example.com/privkey.pem

# Отдельный случайный секрет. Нельзя переиспользовать PROXY_INTERNAL_SECRET:
# MASQUE_TOKEN попадает в устанавливаемый на iPhone профиль.
MASQUE_TOKEN=CHANGE_ME_RANDOM_PER_DEVICE_OR_TEST_COHORT
