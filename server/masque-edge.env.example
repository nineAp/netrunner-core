# Скопировать на ноду в /etc/netrunner/masque-edge.env с правами 0600.
# Сертификат должен быть публично доверенным и содержать relay hostname в SAN.

MASQUE_BIND=0.0.0.0:443
MASQUE_CERT_FILE=/etc/letsencrypt/live/relay.example.com/fullchain.pem
MASQUE_KEY_FILE=/etc/letsencrypt/live/relay.example.com/privkey.pem
MASQUE_MAX_CONNECTIONS=4096

# Production: control-plane validates a separate per-device iosr_* token and
# accounts traffic. The secret below belongs to this node and never enters the
# iPhone profile. MASQUE_USAGE_URL is derived by replacing /validate with
# /usage, so it normally does not need to be set.
MASQUE_AUTH_URL=https://account.netrunner-vpn.com/api/v1/internal/validate
MASQUE_AUTH_SECRET=CHANGE_ME_TO_THIS_NODES_INTERNAL_SECRET
# MASQUE_USAGE_URL=https://account.netrunner-vpn.com/api/v1/internal/usage

# Static-token mode is only for an isolated test cohort. Do not combine it
# with MASQUE_AUTH_URL/MASQUE_AUTH_SECRET.
# MASQUE_TOKEN=CHANGE_ME_RANDOM_TEST_TOKEN
